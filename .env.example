# Copy this file to .env and fill in ONE key. .env is git-ignored.
# The provider is picked from whichever key is set.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings
# WORKER_PROVIDER=gemini            # force a provider: anthropic | gemini | groq | openrouter | openai
# WORKER_MODEL=                     # override the provider's default model
# WORKER_FALLBACK_MODELS=          # comma-separated models to move to when the main one's quota runs out
# LLM_BASE_URL=                     # any other OpenAI-compatible endpoint
# WORKER_EFFORT=high                # Anthropic only
# WORKER_MAX_STEPS=60
# WORKER_REFUSAL_FALLBACK=1         # Anthropic only
# SANDBOX_URL=http://127.0.0.1:8700
